{
  "name": "os-theme",
  "version": "0.0.1",
  "description": "Cross-platform OS theme detection (dark/light mode) with event-driven change notifications for Node.js and Bun",
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/basiclines/os-theme"
  },
  "scripts": {
    "build:native": "./scripts/build-native.sh",
    "test": "bun test",
    "dev": "bun run src/demo.ts",
    "benchmark": "./scripts/benchmark.sh",
    "version:sync": "node scripts/version-sync.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dark-mode",
    "light-mode",
    "theme",
    "appearance",
    "os",
    "system",
    "detect",
    "macos",
    "windows",
    "linux",
    "ffi",
    "native"
  ],
  "optionalDependencies": {
    "@os-theme/darwin-arm64": "0.0.1",
    "@os-theme/linux-x64": "0.0.1",
    "@os-theme/win32-x64": "0.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
